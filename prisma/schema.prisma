generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContentType {
  POST
  CAROUSEL
  STORY
  REEL
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  color       String?     @default("#3B82F6")

  creations   Creation[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Creation {
  id              String      @id @default(cuid())

  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title           String
  prompt          String      @db.Text

  contentType     ContentType

  tone            String?
  creativity      Int?

  caption         String      @db.Text
  hashtags        Json?
  carousel        Json?
  story           Json?
  reel            Json?

  model           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([projectId])
  @@index([createdAt])
}